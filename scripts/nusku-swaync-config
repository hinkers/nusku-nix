#!/usr/bin/env bash
# nusku-swaync-config TEMPLATE DEST: write the swaync quick-settings panel config for this machine.
# Run by the swaync user unit before swaync starts (modules/home/panels.nix), so it follows the
# hardware: the brightness slider needs a backlight device (laptops), and the power-mode buttons
# only list the profiles power-profiles-daemon offers here (the row goes if fewer than two).
# Port of nusku-arch lib/swaync.sh, which did this at install time.
set -uo pipefail

# The first backlight device name, or nothing.
backlight() {
    local d
    for d in "${NUSKU_BACKLIGHT_DIR:-/sys/class/backlight}"/*; do
        [ -e "$d" ] || continue
        printf '%s\n' "${d##*/}"
        return 0
    done
    return 1
}

# The profiles this machine has, space separated (all three if unknown).
power_profiles() {
    if [ -n "${NUSKU_POWER_PROFILES+x}" ]; then
        printf '%s\n' "$NUSKU_POWER_PROFILES"
        return 0
    fi
    local list
    if list="$(powerprofilesctl list 2>/dev/null)" && [ -n "$list" ]; then
        sed -n 's/^[* ] *\([a-z-]*\):$/\1/p' <<<"$list" | tr '\n' ' '
        echo
    else
        echo "power-saver balanced performance"
    fi
}

if [ $# -ne 2 ]; then
    echo "usage: nusku-swaync-config TEMPLATE DEST" >&2
    exit 2
fi
template="$1" dest="$2"
bl="$(backlight)" || bl=""
profiles="$(power_profiles)"
mkdir -p "$(dirname "$dest")"
if jq --arg bl "$bl" --arg profiles " $profiles " '
    (if $bl == "" then
        .widgets -= ["backlight"] | del(."widget-config".backlight)
     else
        ."widget-config".backlight.device = $bl
     end)
    | ."widget-config"."buttons-grid#power".actions |= map(select(
        (.command | split(" ") | last) as $p | $profiles | contains(" " + $p + " ")))
    | if (."widget-config"."buttons-grid#power".actions | length) < 2 then
        .widgets -= ["buttons-grid#power"] | del(."widget-config"."buttons-grid#power")
      else . end
' "$template" >"$dest.tmp" && mv -f "$dest.tmp" "$dest"; then
    echo "Quick settings: ${bl:-no} backlight; power modes: ${profiles% }"
else
    rm -f "$dest.tmp"
    echo "nusku-swaync-config: could not write $dest" >&2
    exit 1
fi
