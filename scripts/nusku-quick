#!/usr/bin/env bash
# nusku-quick: the quick-settings toggles (the Nusku shell's panel: Super + N, or the bar's pill).
#   nusku-quick status NAME   print true or false
#   nusku-quick toggle NAME   flip it
#   nusku-quick power PROFILE set a power profile (power-saver, balanced, performance)
# NAME: wifi bluetooth dnd night airplane caffeine mic sound power-<profile>
set -uo pipefail

NIGHT_TEMP="${NUSKU_NIGHT_TEMP:-4000}"

# The header above, printed as is: not read back from $0, which in the Nix package starts
# with extra lines (lib/scripts.nix).
usage() {
    cat <<'USAGE'
nusku-quick status NAME   print true or false
nusku-quick toggle NAME   flip it
nusku-quick power PROFILE set a power profile (power-saver, balanced, performance)
NAME: wifi bluetooth dnd night airplane caffeine mic sound power-<profile>
USAGE
}

say() { notify-send -a Nusku -u low "$@" 2>/dev/null || true; }
bool() { if "$@" >/dev/null 2>&1; then echo true; else echo false; fi; }
running() { pgrep -x "$1" >/dev/null 2>&1; }
detach() { setsid -f "$@" >/dev/null 2>&1 </dev/null; }

wifi_on() { [ "$(nmcli radio wifi 2>/dev/null)" = enabled ]; }
bt_on() { bluetoothctl show 2>/dev/null | grep -q 'Powered: yes'; }
# Do Not Disturb lives in the Nusku shell (Quickshell, config/quickshell/nusku).
dnd_on() { [ "$(qs -c nusku ipc call notifications dnd 2>/dev/null)" = true ]; }
mic_muted() { wpctl get-volume @DEFAULT_AUDIO_SOURCE@ 2>/dev/null | grep -q MUTED; }
idle_on() { systemctl --user is-active --quiet swayidle; }
sound_muted() { wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null | grep -q MUTED; }
# Airplane mode: every radio is soft-blocked (and there is at least one).
airplane_on() {
    local states
    states="$(rfkill -n -o SOFT 2>/dev/null)" || return 1
    [ -n "$states" ] && ! grep -qx unblocked <<<"$states"
}

status() {
    case "$1" in
        wifi) bool wifi_on ;;
        bluetooth) bool bt_on ;;
        dnd) bool dnd_on ;;
        night) bool running wlsunset ;;
        airplane) bool airplane_on ;;
        caffeine) bool eval '! idle_on' ;;
        mic) bool mic_muted ;;
        sound) bool sound_muted ;;
        power-*) bool test "$(powerprofilesctl get 2>/dev/null)" = "${1#power-}" ;;
        *) echo false; return 2 ;;
    esac
}

toggle() {
    case "$1" in
        wifi) if wifi_on; then nmcli radio wifi off; else nmcli radio wifi on; fi ;;
        bluetooth)
            if bt_on; then
                bluetoothctl power off
            else
                rfkill unblock bluetooth 2>/dev/null
                bluetoothctl power on
            fi ;;
        dnd) qs -c nusku ipc call notifications toggleDnd ;;
        night)
            # wlsunset with day and night 1 K apart: a fixed warm screen, whatever the time.
            if running wlsunset; then
                pkill -x wlsunset
            elif command -v wlsunset >/dev/null 2>&1; then
                detach wlsunset -t "$NIGHT_TEMP" -T "$((NIGHT_TEMP + 1))" -S 06:00 -s 18:00
            else
                say "Night light" "wlsunset is not installed. Run nusku-update to add it."
                return 1
            fi ;;
        airplane) if airplane_on; then rfkill unblock all; else rfkill block all; fi ;;
        caffeine)
            # Keep awake = the swayidle service stopped; it comes back on the next login anyway.
            if idle_on; then systemctl --user stop swayidle; else systemctl --user start swayidle; fi ;;
        mic) wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle ;;
        sound) wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
        power-*) powerprofilesctl set "${1#power-}" ;;
        *) echo "nusku-quick: unknown toggle: $1" >&2; return 2 ;;
    esac
}

case "${1:-}" in
    status) status "${2:?which toggle?}" ;;
    toggle) toggle "${2:?which toggle?}" >/dev/null ;;
    power) toggle "power-${2:?which profile?}" >/dev/null ;;
    *) usage; exit 2 ;;
esac
