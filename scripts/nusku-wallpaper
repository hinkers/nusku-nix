#!/usr/bin/env bash
# nusku-wallpaper set FILE [MONITOR|all] | restore | list
# State: ~/.local/state/nusku/wallpapers (lines MONITOR=/abs/path, *=/abs/path for all monitors).
set -euo pipefail

# Home Manager links the repo's wallpapers here. Saved paths keep this prefix (not the
# /nix/store path behind it), so a choice survives rebuilds that change the store path.
wallpapers="${NUSKU_WALLPAPERS:-${XDG_DATA_HOME:-$HOME/.local/share}/nusku/wallpapers}"

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/nusku"
state_file="$state_dir/wallpapers"
current_link="$state_dir/current-wallpaper"
sddm_dir="${NUSKU_SDDM_BG_DIR:-/var/lib/nusku/sddm-background}"
default_wallpaper="$wallpapers/space.png"

die() {
    printf 'nusku-wallpaper: %s\n' "$*" >&2
    exit 1
}

warn() {
    printf 'nusku-wallpaper: warning: %s\n' "$*" >&2
}

_have_niri() {
    command -v niri >/dev/null 2>&1 && [ -n "${NIRI_SOCKET:-}" ]
}

# _apply: (re)start swaybg from the saved state ("fill" = cover). swaybg prefers an exact
# output match over the * entry. The only place that draws the wallpaper.
_apply() {
    _have_niri || return 0
    command -v swaybg >/dev/null 2>&1 || { warn "swaybg is not installed; wallpaper not applied"; return 0; }
    local line k v args=()
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        k="${line%%=*}"
        v="${line#*=}"
        [ -f "$v" ] && args+=(-o "$k" -i "$v" -m fill)
    done <"$state_file"
    [ "${#args[@]}" -gt 0 ] || return 0
    # Nix wraps swaybg: the running process is called .swaybg-wrapped.
    pkill -x -u "$(id -u)" '(\.)?swaybg(-wrapped)?' 2>/dev/null || true
    setsid -f swaybg "${args[@]}" >/dev/null 2>&1 </dev/null || warn "swaybg failed to start"
}

# _state_get KEY: print the path saved for KEY, if any.
_state_get() {
    [ -r "$state_file" ] || return 0
    local line
    while IFS= read -r line; do
        if [ "${line%%=*}" = "$1" ]; then
            printf '%s\n' "${line#*=}"
            return 0
        fi
    done <"$state_file"
}

_update_link() {
    local img first
    img="$(_state_get '*')"
    if [ -z "$img" ] && [ -r "$state_file" ]; then
        first="$(head -n1 "$state_file")"
        img="${first#*=}"
    fi
    [ -n "$img" ] && ln -sfn "$img" "$current_link"
    return 0
}

_sddm_copy() {
    local file="$1" ext
    ext="${file##*.}"
    if [ -d "$sddm_dir" ] && [ -w "$sddm_dir" ]; then
        rm -f "$sddm_dir"/background.* 2>/dev/null || true
        if cp -f "$file" "$sddm_dir/background.$ext" 2>/dev/null &&
            ln -sfn "background.$ext" "$sddm_dir/background"; then
            return 0
        fi
    fi
    warn "cannot write SDDM background to $sddm_dir; skipping"
}

cmd_set() {
    local file="${1:-}" target="${2:-all}" key line tmp
    [ -n "$file" ] || die "usage: nusku-wallpaper set FILE [MONITOR|all]"
    [ -f "$file" ] || die "file not found: $file"
    # Absolute, but symlinks kept (see $wallpapers above).
    file="$(realpath -s "$file")"
    mkdir -p "$state_dir"

    key="$target"
    [ "$target" = "all" ] && key='*'

    tmp="$(mktemp "$state_dir/.wallpapers.XXXXXX")"
    if [ "$key" != '*' ] && [ -r "$state_file" ]; then
        while IFS= read -r line; do
            [ "${line%%=*}" = "$key" ] || printf '%s\n' "$line"
        done <"$state_file" >"$tmp"
    fi
    if [ "$key" = '*' ]; then
        printf '*=%s\n' "$file" >"$tmp"
    else
        printf '%s=%s\n' "$key" "$file" >>"$tmp"
    fi
    mv -f "$tmp" "$state_file"
    _update_link

    [ "$key" != '*' ] || _sddm_copy "$file"
    _apply
}

# _prune_missing: drop saved entries whose file is gone (e.g. the repo was moved);
# a missing * entry becomes the default wallpaper. Rewrites state only if something changed.
_prune_missing() {
    local line k v tmp changed=0
    tmp="$(mktemp "$state_dir/.wallpapers.XXXXXX")"
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        k="${line%%=*}"
        v="${line#*=}"
        if [ -f "$v" ]; then
            printf '%s\n' "$line"
            continue
        fi
        changed=1
        if [ "$k" = '*' ]; then
            warn "saved wallpaper $v is missing; using the default"
            printf '*=%s\n' "$default_wallpaper"
        else
            warn "saved wallpaper $v for $k is missing; dropping it"
        fi
    done <"$state_file" >"$tmp"
    if [ "$changed" -eq 1 ]; then
        mv -f "$tmp" "$state_file"
    else
        rm -f "$tmp"
    fi
}

cmd_restore() {
    [ ! -s "$state_file" ] || _prune_missing
    if [ ! -s "$state_file" ]; then
        cmd_set "$default_wallpaper" all
        return 0
    fi
    _update_link
    _apply
}

cmd_list() {
    local f
    for f in "$wallpapers"/*.{png,jpg,jpeg,webp}; do
        [ -f "$f" ] && printf '%s\n' "$f"
    done
    return 0
}

case "${1:-}" in
    set) shift; cmd_set "$@" ;;
    restore) cmd_restore ;;
    list) cmd_list ;;
    *) printf 'Usage: nusku-wallpaper set FILE [MONITOR|all] | restore | list\n' >&2; exit 2 ;;
esac
