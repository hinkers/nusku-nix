// Generated by Nix from lib/palette.nix (modules/home/theme.nix); do not edit.
// niri colours (Catppuccin Mocha + the chosen accent) and the cursor; included by
// ~/.config/niri/config.kdl. Override any of it in ~/.config/nusku/local.kdl.
layout {
    background-color "#{{base}}"
    border {
        active-color "#{{accent}}"
        inactive-color "#{{surface0}}"
        urgent-color "#{{red}}"
    }
    shadow {
        color "#{{crust}}aa"
    }
    tab-indicator {
        active-color "#{{accent}}"
        inactive-color "#{{surface1}}"
    }
    insert-hint {
        color "#{{accent}}80"
    }
}

overview {
    backdrop-color "#{{crust}}"
}

cursor {
    xcursor-theme "catppuccin-mocha-{{accent_name}}-cursors"
    xcursor-size 24
}
