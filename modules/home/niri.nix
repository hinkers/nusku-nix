# The niri desktop for the user: the niri config and Kitty linked from config/, the GPU KDL from
# modules/nixos/gpu.nix, the lock screen (hyprlock) and idle policy (swayidle), the polkit agent,
# the wallpapers and the wallpaper scripts, and the user's own files (created once, never managed).
{ osConfig, config, lib, pkgs, ... }:
let
  scripts = import ../../lib/scripts.nix { inherit pkgs lib; };
  niri = osConfig.programs.niri.package; # the same niri the session runs (niri msg)
  hyprlock = osConfig.programs.hyprlock.package;
  configFile = name: config.xdg.configFile.${name}.text;

  # Every regular file under `dir` as xdg.configFile."<prefix>/<relative path>" (one entry per
  # file, so other modules can add files to the same directory).
  linkTree = prefix: dir:
    lib.listToAttrs (map
      (path:
        let rel = lib.removePrefix (toString dir + "/") (toString path); in
        lib.nameValuePair "${prefix}/${rel}" { source = path; })
      (lib.filesystem.listFilesRecursive dir));

  # config.kdl, checked with `niri validate` against the files it includes (as they will be in
  # ~/.config), so a broken config fails the rebuild instead of the login. local.kdl is the
  # user's and optional, so it is left out.
  niriConfig = pkgs.runCommand "niri-config.kdl"
    {
      nativeBuildInputs = [ niri ];
      colors = configFile "nusku/theme/niri-colors.kdl";
      gpu = configFile "nusku/gpu.kdl";
      input = configFile "nusku/input.kdl";
      apps = configFile "nusku/apps.kdl";
      passAsFile = [ "colors" "gpu" "input" "apps" ];
    } ''
    mkdir -p cfg/niri cfg/nusku/theme
    cp ${../../config/niri}/*.kdl cfg/niri/
    cp "$colorsPath" cfg/nusku/theme/niri-colors.kdl
    cp "$gpuPath" cfg/nusku/gpu.kdl
    cp "$inputPath" cfg/nusku/input.kdl
    cp "$appsPath" cfg/nusku/apps.kdl
    niri validate -c cfg/niri/config.kdl
    cp cfg/niri/config.kdl $out
  '';

  nusku-wallpaper = scripts.mkScript {
    name = "nusku-wallpaper";
    deps = with pkgs; [ coreutils procps util-linux swaybg niri ];
  };

  # The user's own files: written once from these templates, never touched again.
  localKdl = pkgs.writeText "local.kdl" ''
    // Your own niri settings. Nusku never overwrites this file.
    // It is included last by ~/.config/niri/config.kdl, so anything here wins; a key bound
    // here replaces the same key in Nusku's binds. Docs: https://yalter.github.io/niri/
    // Examples:
    //   output "DP-1" { mode "2560x1440@144"; scale 1; position x=0 y=0; }
    //   input { keyboard { xkb { layout "us,de"; options "grp:alt_shift_toggle"; } } }
    //   binds { Mod+Shift+D hotkey-overlay-title="Discord" { spawn "discord"; } }
  '';
  localZsh = pkgs.writeText "local.zsh" ''
    # Your own zsh settings. Nusku never overwrites this file.
    # It is sourced last by ~/.zshrc, so anything here wins. Examples:
    #   alias ll='eza -la'
    #   export EDITOR=nvim
    #   path+=("$HOME/bin")
  '';

in
{
  xdg.configFile = linkTree "niri" ../../config/niri // linkTree "kitty" ../../config/kitty // {
    "niri/config.kdl" = lib.mkForce { source = niriConfig; };
    # Lock screen: hyprlock (the clock above the password field, on the blurred wallpaper, in the
    # palette's colours). Its PAM service is in modules/nixos/desktop.nix.
    "hypr/hyprlock.conf".source = ../../config/hypr/hyprlock.conf;
    # GPU environment and laptop screen scale (modules/nixos/gpu.nix).
    "nusku/gpu.kdl".text = osConfig.nusku.internal.niriGpuKdl;
    # The keyboard layout (settings.json "keymap", an xkb layout), included after config.kdl's
    # own settings and before local.kdl, so local.kdl can still change it.
    "nusku/input.kdl".text = ''
      // Nusku keyboard layout (generated from settings.json "keymap"; included by ~/.config/niri/config.kdl)
      input {
          keyboard {
              xkb {
                  layout ${builtins.toJSON osConfig.nusku.keymap}
              }
          }
      }
    '';
    # Startup commands and binds for picked apps. types.lines: each app's module adds its own
    # block (browsers.nix: Obsidian, shell.nix: Yazi). Always written, as config.kdl includes it.
    "nusku/apps.kdl".text = lib.mkBefore ''
      // Nusku: startup commands and binds for the apps you picked (generated by Nix; included by
      // ~/.config/niri/config.kdl).
    '';
  };

  # A stable path for the wallpapers: nusku-wallpaper saves choices under it.
  xdg.dataFile."nusku/wallpapers".source = ../../wallpapers;

  home.packages = (with pkgs; [
    kitty
    swaybg
    grim
    slurp
    wl-clipboard
    cliphist
    brightnessctl
    playerctl
    pavucontrol
    libnotify
    jq
    imagemagick
    xdg-user-dirs
  ]) ++ [ nusku-wallpaper ];

  # Started with the session (graphical-session.target, which niri-session reaches).
  services.polkit-gnome.enable = true;

  # Idle policy: dim at 5 min, lock at 10 min, screens off at 11 min. No auto-suspend (laptops:
  # add one in your own config if wanted). The quick-settings "caffeine" toggle stops this unit.
  services.swayidle = {
    enable = true;
    timeouts = [
      { timeout = 300; command = "${pkgs.brightnessctl}/bin/brightnessctl -s set 10%"; resumeCommand = "${pkgs.brightnessctl}/bin/brightnessctl -r"; }
      { timeout = 600; command = "/run/current-system/sw/bin/loginctl lock-session"; }
      { timeout = 660; command = "${niri}/bin/niri msg action power-off-monitors"; resumeCommand = "${niri}/bin/niri msg action power-on-monitors"; }
    ];
    events = {
      # One lock screen, however many times it is asked for.
      lock = "${pkgs.procps}/bin/pidof hyprlock || ${hyprlock}/bin/hyprlock";
      before-sleep = "/run/current-system/sw/bin/loginctl lock-session";
    };
  };

  xdg.userDirs = {
    enable = true;
    createDirectories = true;
  };

  # local.kdl / local.zsh: created only if missing. They and the wallpaper state
  # (~/.local/state/nusku) are never in home.file, so rebuilds keep them.
  home.activation.nuskuLocalFiles = lib.hm.dag.entryAfter [ "writeBoundary" ] ''
    nuskuDir="${config.xdg.configHome}/nusku"
    run mkdir -p "$nuskuDir" "${config.home.homeDirectory}/Pictures/Screenshots"
    if [ ! -e "$nuskuDir/local.kdl" ]; then
      run install -m 644 ${localKdl} "$nuskuDir/local.kdl"
    fi
    if [ ! -e "$nuskuDir/local.zsh" ]; then
      run install -m 644 ${localZsh} "$nuskuDir/local.zsh"
    fi
  '';
}
