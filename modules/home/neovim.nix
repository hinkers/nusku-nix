# Neovim (the `neovim` app; the editor and the tools LazyVim calls are in modules/nixos/apps.nix)
# with nusku-arch's LazyVim config, Mason off: everything it would have downloaded comes from
# Nix instead.
#  - ~/.config/nvim: nusku-arch's config/nvim, linked file by file so the directory stays
#    writable (LazyVim saves lazyvim.json there, as nusku-arch's gitignored copy). lazy.nvim
#    still installs the plugins at the committed lazy-lock.json revisions (spec §7), from a
#    writable copy of that file (lua/nusku/lockfile.lua).
#  - ~/.config/nusku/nvim-languages.lua: the picked languages (catalogue order); LazyVim imports
#    their extras (lua/nusku/languages.lua).
#  - ~/.config/nusku/nvim-nix.lua: store paths for nvim-treesitter, its grammars, blink.cmp (with
#    its fuzzy-matching library built by nixpkgs, which blink.cmp would otherwise download from
#    GitHub) and Lombok (lua/nusku/nix.lua, lua/plugins/nusku-nix.lua).
#  - the language servers, formatters and linters of the picked languages, plus LazyVim's own
#    (lib/langs.nix), in the user's profile: on nusku-arch Mason installed them for Neovim only.
#  - the accent file (~/.config/nusku/theme/nvim-accent.lua) is rendered with the others in
#    theme.nix.
# Rust's rustup default and components are a language step, Neovim or not: modules/home/langs.nix.
{ osConfig, lib, pkgs, ... }:
let
  inherit (lib) mkIf;
  cfg = osConfig.nusku;
  catalogue = import ../../lib/catalogue.nix;
  langs = import ../../lib/langs.nix pkgs;
  neovim = builtins.elem "neovim" cfg.apps;
  langPicked = id: builtins.elem id cfg.langs;
  # Picked language ids in catalogue order (nusku-arch's apps_write_nvim_languages).
  picked = map (l: l.id) (builtins.filter (l: langPicked l.id) catalogue.langs);

  ts = pkgs.vimPlugins.nvim-treesitter;
  # Every grammar nixpkgs builds for this nvim-treesitter (parser/<lang>.so) and every query set
  # (queries/<lang>, including query-only ones such as ecma that others inherit): what
  # nvim-treesitter.withAllGrammars puts on the runtimepath, as one directory that
  # nvim-treesitter uses as its install_dir.
  grammars = pkgs.symlinkJoin {
    name = "nvim-treesitter-grammars";
    paths = builtins.attrValues ts.parsers ++ builtins.attrValues ts.queries;
  };

  quote = s: ''"${s}"'';
in
{
  xdg.configFile = mkIf neovim {
    "nvim" = {
      source = ../../config/nvim;
      recursive = true;
    };
    "nusku/nvim-languages.lua".text =
      if picked == [ ] then "return {}\n"
      else "return { ${lib.concatMapStringsSep ", " quote picked} }\n";
    "nusku/nvim-nix.lua".text = lib.concatLines ([
      "-- Generated by Nix (modules/home/neovim.nix); read by lua/nusku/nix.lua."
      "return {"
      "  treesitter = \"${ts}\","
      "  textobjects = \"${pkgs.vimPlugins.nvim-treesitter-textobjects}\","
      "  parsers = \"${grammars}\","
      "  blink = \"${pkgs.vimPlugins.blink-cmp}\","
    ] ++ lib.optional (langPicked "java") "  lombok = \"${pkgs.lombok}/share/java/lombok.jar\","
    ++ [ "}" ]);
  };

  # git: lazy.nvim clones the plugins.
  home.packages = mkIf neovim (
    langs.core ++ [ pkgs.git ] ++ lib.concatMap (id: langs.langs.${id}.tools or [ ]) picked
  );
}
