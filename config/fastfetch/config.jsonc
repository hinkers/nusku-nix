{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  // Icons are Nerd Font glyphs (kitty uses JetBrainsMono Nerd Font). Colours: Catppuccin Mocha.
  "logo": { "color": { "1": "38;2;137;180;250", "2": "38;2;203;166;247" }, "padding": { "right": 2 } },
  "display": {
    "separator": "  ",
    "color": { "keys": "38;2;203;166;247", "title": "38;2;137;180;250", "separator": "38;2;108;112;134" }
  },
  "modules": [
    "title",
    "separator",
    { "type": "os", "key": " OS" },
    { "type": "kernel", "key": " Kernel" },
    { "type": "uptime", "key": " Uptime" },
    { "type": "shell", "key": " Shell" },
    { "type": "de", "key": " DE" },
    { "type": "wm", "key": " WM" },
    { "type": "terminal", "key": " Terminal" },
    // Short names: the CPU model without the marketing words (e.g. "Intel i7-1260P"), the GPU's
    // name without its vendor, clock and type.
    { "type": "command", "key": " CPU", "text": "sed -n \"s/^model name[[:space:]]*: //p\" /proc/cpuinfo | head -n1 | sed -E \"s/\\((R|TM)\\)//g; s/[0-9]+(st|nd|rd|th) Gen //; s/ (CPU|Processor)//g; s/ @.*//; s/ (w\\/|with) .*//; s/Core //; s/ [0-9]+-Core//; s/  +/ /g; s/ +$//\"" },
    { "type": "gpu", "key": " GPU", "format": "{name}" },
    { "type": "memory", "key": " Memory" },
    { "type": "disk", "key": " Disk" },
    "break",
    "colors"
  ]
}
